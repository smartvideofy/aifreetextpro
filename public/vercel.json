{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!api|assets|_debug|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
